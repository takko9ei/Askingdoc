# Copy this file to .env and fill in real values. .env is git-ignored --
# src/config.py reads these four variables via python-dotenv and exposes
# them as Config.embedding_api_key / embedding_base_url / llm_api_key /
# llm_base_url. Never commit the real .env.
#
# Embedding and LLM get separate key/url pairs because they are commonly
# two different providers (e.g. a dedicated embedding endpoint for
# BAAI/bge-m3 vs. a chat-completions endpoint for the answer-generation
# model) -- if yours happen to be the same provider, just put the same
# values in both pairs.

# Used for the embedding calls (indexer.py building the vector index,
# search.py embedding the query). Tested by STEP0's "landmine 3" check:
#   from openai import OpenAI
#   c = OpenAI(api_key=EMBEDDING_API_KEY, base_url=EMBEDDING_BASE_URL)
#   c.embeddings.create(model="BAAI/bge-m3", input=["test"])
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Used for the answer-generation calls (src/generation/answerer.py, STEP2+).
LLM_API_KEY=
LLM_BASE_URL=
